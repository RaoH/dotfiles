# skhd config - keybindings for yabai
# Mirrors your Aerospace keybindings
#
# Syntax: <modifier> - <key> : <command>
# Modifiers: alt, shift, cmd, ctrl, fn

# ===== Focus windows (alt + hjkl) =====
alt - h : yabai -m window --focus west
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
alt - l : yabai -m window --focus east

# ===== Move windows (alt + shift + hjkl) =====
alt + shift - h : yabai -m window --swap west
alt + shift - j : yabai -m window --swap south
alt + shift - k : yabai -m window --swap north
alt + shift - l : yabai -m window --swap east

# ===== Resize windows (alt + shift + minus/equal) =====
alt + shift - 0x1B : yabai -m window --resize left:50:0; yabai -m window --resize right:-50:0
alt + shift - 0x18 : yabai -m window --resize left:-50:0; yabai -m window --resize right:50:0

# ===== Switch workspaces (alt + 1-9, 0) =====
alt - 1 : yabai -m space --focus 1
alt - 2 : yabai -m space --focus 2
alt - 3 : yabai -m space --focus 3
alt - 4 : yabai -m space --focus 4
alt - 5 : yabai -m space --focus 5
alt - 6 : yabai -m space --focus 6
alt - 7 : yabai -m space --focus 7
alt - 8 : yabai -m space --focus 8
alt - 9 : yabai -m space --focus 9
alt - 0 : yabai -m space --focus 10

# ===== Move window to workspace (alt + shift + 1-9, 0) =====
alt + shift - 1 : yabai -m window --space 1; yabai -m space --focus 1
alt + shift - 2 : yabai -m window --space 2; yabai -m space --focus 2
alt + shift - 3 : yabai -m window --space 3; yabai -m space --focus 3
alt + shift - 4 : yabai -m window --space 4; yabai -m space --focus 4
alt + shift - 5 : yabai -m window --space 5; yabai -m space --focus 5
alt + shift - 6 : yabai -m window --space 6; yabai -m space --focus 6
alt + shift - 7 : yabai -m window --space 7; yabai -m space --focus 7
alt + shift - 8 : yabai -m window --space 8; yabai -m space --focus 8
alt + shift - 9 : yabai -m window --space 9; yabai -m space --focus 9
alt + shift - 0 : yabai -m window --space 10; yabai -m space --focus 10

# ===== Toggle layout (alt + slash) =====
alt - slash : yabai -m space --layout $(yabai -m query --spaces --space | jq -r 'if .type == "bsp" then "stack" else "bsp" end')

# ===== Back and forth (alt + tab) =====
alt - tab : yabai -m space --focus recent

# ===== Move workspace to monitor (alt + shift + tab) =====
alt + shift - tab : yabai -m space --display next || yabai -m space --display first

# ===== Toggle float (alt + shift + semicolon, then f) =====
# For simplicity, direct binding:
alt + shift - f : yabai -m window --toggle float; yabai -m window --grid 4:4:1:1:2:2

# ===== Fullscreen toggle =====
alt + shift - g : yabai -m window --toggle zoom-fullscreen

# ===== Reset/balance layout =====
alt + shift - r : yabai -m space --balance

# ===== Close window =====
alt + shift - q : yabai -m window --close

# ===== Restart yabai =====
ctrl + alt + cmd - r : yabai --restart-service
